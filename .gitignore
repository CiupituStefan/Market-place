# dependencies
node_modules/
.pnpm-store/

# build output
dist/
.next/
out/
*.tsbuildinfo

# tooling caches
.turbo/
coverage/
.eslintcache

# env & secrets — never commit real values
.env
.env.*
!.env.example
*.pem
# public Amazon RDS root certificates (no private keys)
!infrastructure/helm/marketplace/files/rds-ca-*.pem
*.key

# terraform
**/.terraform/*
# modules are locked by the stacks that use them
infrastructure/terraform/modules/**/.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
# Environment settings (sizes, domains, CIDRs): reviewed, never secrets.
!infrastructure/terraform/envs/**/*.tfvars
crash.log

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# test artifacts
playwright-report/
test-results/

# next.js generated
next-env.d.ts
dump.rdb

# code scanning reports (CI, scripts/security-scan.sh with SARIF_DIR)
.sarif/
