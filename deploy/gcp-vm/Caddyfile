# HTTPS for the API gateway. Caddy obtains and renews the Let's Encrypt certificate itself once
# the DNS record for {$API_DOMAIN} points at this machine (no account email needed).

{$API_DOMAIN} {
	encode zstd gzip
	header {
		# The API is HTTPS-only; browsers must never try plain HTTP for it again.
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		-Server
	}
	reverse_proxy api-gateway:4000
	log {
		output stdout
		format json
	}
}
