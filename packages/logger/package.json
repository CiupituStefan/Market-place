{
  "name": "@market/logger",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Structured JSON logging (pino) with request-ID correlation and secret redaction.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo coverage"
  },
  "dependencies": {
    "pino": "^10.4.0"
  },
  "optionalDependencies": {
    "pino-pretty": "^13.2.0"
  },
  "devDependencies": {
    "@market/eslint-config": "workspace:*",
    "@market/tsconfig": "workspace:*",
    "@types/node": "^22.19.0",
    "eslint": "^10.12.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
