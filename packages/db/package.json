{
  "name": "@market/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared PostgreSQL plumbing: connection pool, migrations, transactional outbox, PGlite test databases.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo coverage"
  },
  "dependencies": {
    "@market/events": "workspace:*",
    "@market/logger": "workspace:*",
    "@market/telemetry": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.1"
  },
  "peerDependencies": {
    "@electric-sql/pglite": "^0.5.8"
  },
  "peerDependenciesMeta": {
    "@electric-sql/pglite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@market/eslint-config": "workspace:*",
    "@market/tsconfig": "workspace:*",
    "@market/types": "workspace:*",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.23.1",
    "eslint": "^10.12.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  }
}
