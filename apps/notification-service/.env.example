# Copy to .env for local development. Never commit real values.
NODE_ENV=development
PORT=4007
LOG_LEVEL=debug
DATABASE_URL=postgresql://notifications:notifications-dev-password@localhost:5432/notifications
AUTH_JWKS_URL=http://localhost:4001/.well-known/jwks.json
# Links in emails.
WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000

# log (prints emails), smtp (Mailpit: smtp://localhost:1025) or ses (AWS, IAM role credentials).
EMAIL_PROVIDER=log
# SMTP_URL=smtp://localhost:1025
# SES_REGION=eu-central-1
EMAIL_FROM="CSE Keyboards <hello@csekeyboards.test>"
# At least 32 characters; required in production (Secrets Manager). Signs unsubscribe links.
# UNSUBSCRIBE_SECRET=

# Kafka (messaging). Without KAFKA_BROKERS no events are consumed (development only).
# KAFKA_BROKERS=localhost:9092
