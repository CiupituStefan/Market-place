# Copy to .env for local development. Never commit real values.
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
# Browser origins allowed for CORS and cookie-authenticated writes (comma separated).
CORS_ORIGINS=http://localhost:3000
# Optional locally; required in production so limits are shared by all replicas.
REDIS_URL=redis://localhost:6379
RATE_LIMIT_ENABLED=true
# Trusted proxy hops in front of the gateway (1 behind the AWS ALB).
TRUST_PROXY=0
UPSTREAM_TIMEOUT_MS=10000
MAX_BODY_BYTES=1048576
# Defaults to true outside production.
DOCS_ENABLED=true
# Upstreams default to http://localhost:<port>; override per service, e.g.:
# ORDER_SERVICE_URL=http://order-service:4005
