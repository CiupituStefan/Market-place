# Copy to .env for local development. Never commit real values.
NODE_ENV=development
PORT=4001
LOG_LEVEL=debug
DATABASE_URL=postgresql://auth:auth-dev-password@localhost:5432/auth
DATABASE_POOL_MAX=10
# Leave empty locally to use an ephemeral key. Production: PKCS#8 PEM (or base64 of it)
# from AWS Secrets Manager. Generate with:
#   openssl genpkey -algorithm ed25519 | base64 -w0
JWT_PRIVATE_KEY=
JWT_KEY_ID=auth-key-1
JWT_ISSUER=cse-auth
ACCESS_TOKEN_TTL_SECONDS=900
SESSION_TTL_DAYS=30
WEB_URL=http://localhost:3000
# false locally (plain http); always true in production.
COOKIE_SECURE=false
# Development only: print verification/reset links until notification-service exists.
DEV_LOG_EMAIL_LINKS=true
