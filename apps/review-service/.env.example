# Copy to .env for local development. Never commit real values.
NODE_ENV=development
PORT=4008
LOG_LEVEL=debug
DATABASE_URL=postgresql://reviews:reviews-dev-password@localhost:5432/reviews
AUTH_JWKS_URL=http://localhost:4001/.well-known/jwks.json
PRODUCT_SERVICE_URL=http://localhost:4002
# Reports from different shoppers that send a published review back to moderation.
REPORTS_TO_HIDE=3

# Kafka (messaging). Without KAFKA_BROKERS, events stay in the outbox (development only).
# KAFKA_BROKERS=localhost:9092
