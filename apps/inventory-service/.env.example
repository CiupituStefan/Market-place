# Copy to .env for local development. Never commit real values.
NODE_ENV=development
PORT=4003
LOG_LEVEL=debug
DATABASE_URL=postgresql://inventory:inventory-dev-password@localhost:5432/inventory
AUTH_JWKS_URL=http://localhost:4001/.well-known/jwks.json
RESERVATION_TTL_SECONDS=900
EXPIRY_SWEEP_INTERVAL_MS=15000
EXPIRY_BATCH_SIZE=100
DEFAULT_LOW_STOCK_THRESHOLD=5
# Only used by the demo seed (reads variants from the catalog).
PRODUCT_SERVICE_URL=http://localhost:4002

# Kafka (messaging). Without KAFKA_BROKERS, events stay in the outbox (development only).
# KAFKA_BROKERS=localhost:9092
# KAFKA_SSL=false
