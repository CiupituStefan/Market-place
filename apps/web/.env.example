# Public values are inlined into the browser bundle: never put secrets in NEXT_PUBLIC_*.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Browser-facing API base (the api-gateway).
NEXT_PUBLIC_API_URL=http://localhost:4000
# CloudFront host serving product images, e.g. cdn.csekeyboards.com
NEXT_PUBLIC_ASSET_HOST=
# Server-side API base used by Server Components (in-cluster gateway address).
API_INTERNAL_URL=http://localhost:4000
