{
  "extends": "@market/tsconfig/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "*.config.ts",
    "*.config.mjs",
    "vitest.setup.ts"
  ],
  "exclude": ["node_modules", ".next/cache"]
}
