# Copy to .env for local development. Never commit real values.
NODE_ENV=development
PORT=4006
LOG_LEVEL=debug
DATABASE_URL=postgresql://payments:payments-dev-password@localhost:5432/payments
AUTH_JWKS_URL=http://localhost:4001/.well-known/jwks.json
ORDER_SERVICE_URL=http://localhost:4005

# Without Stripe keys: simulated payments (refused in production).
PAYMENT_PROVIDER=mock
STRIPE_WEBHOOK_SECRET=whsec_local_development_only

# With Stripe test keys (from the Stripe dashboard; the webhook secret from `stripe listen`):
# PAYMENT_PROVIDER=stripe
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
WEBHOOK_TOLERANCE_SECONDS=300
