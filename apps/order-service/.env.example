# Copy to .env for local development. Never commit real values.
NODE_ENV=development
PORT=4005
LOG_LEVEL=debug
DATABASE_URL=postgresql://orders:orders-dev-password@localhost:5432/orders
AUTH_JWKS_URL=http://localhost:4001/.well-known/jwks.json
CART_SERVICE_URL=http://localhost:4004
INVENTORY_SERVICE_URL=http://localhost:4003
# Stock is held this long while the shopper pays (also the reservation TTL, max 3600).
PAYMENT_WINDOW_SECONDS=1800
PAYMENT_GRACE_SECONDS=120
CHECKOUT_STALE_SECONDS=300
SWEEP_INTERVAL_MS=30000
SWEEP_BATCH_SIZE=50
SWEEPER_ENABLED=true
