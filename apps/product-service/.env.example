# Copy to .env for local development. Never commit real values.
NODE_ENV=development
PORT=4002
LOG_LEVEL=debug
DATABASE_URL=postgresql://products:products-dev-password@localhost:5432/products
DATABASE_POOL_MAX=10
AUTH_JWKS_URL=http://localhost:4001/.well-known/jwks.json
JWT_ISSUER=cse-auth
CATALOG_CURRENCY=EUR
# Image uploads (optional outside Docker Compose, which provides an S3-compatible store).
S3_BUCKET=
S3_REGION=eu-central-1
S3_ENDPOINT=
# Browser-facing endpoint for upload forms when it differs (Docker Compose: http://localhost:9000)
S3_PUBLIC_ENDPOINT=
ASSET_BASE_URL=
IMAGE_MAX_BYTES=10485760

# Kafka (messaging). Without KAFKA_BROKERS, events stay in the outbox (development only).
# KAFKA_BROKERS=localhost:9092
# KAFKA_SSL=false
