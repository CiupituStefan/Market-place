# Copy to .env for local development. Never commit real values.
NODE_ENV=development
PORT=4009
LOG_LEVEL=debug
DATABASE_URL=postgresql://admin:admin-dev-password@localhost:5432/admin
AUTH_JWKS_URL=http://localhost:4001/.well-known/jwks.json
# Reporting day boundaries and currency.
ANALYTICS_TIME_ZONE=Europe/Bucharest
ANALYTICS_CURRENCY=EUR

# Kafka (messaging). Without KAFKA_BROKERS the read model is not updated (development only).
# KAFKA_BROKERS=localhost:9092
