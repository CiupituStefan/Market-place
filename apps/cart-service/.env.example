# Copy to .env for local development. Never commit real values.
NODE_ENV=development
PORT=4004
LOG_LEVEL=debug
DATABASE_URL=postgresql://cart:cart-dev-password@localhost:5432/cart
AUTH_JWKS_URL=http://localhost:4001/.well-known/jwks.json
PRODUCT_SERVICE_URL=http://localhost:4002
INVENTORY_SERVICE_URL=http://localhost:4003
CURRENCY=EUR
# VAT contained in shelf prices, basis points (2100 = 21%).
VAT_RATE_BPS=2100
# Minor units: 9900 = €99.00, 690 = €6.90.
FREE_SHIPPING_THRESHOLD=9900
SHIPPING_FLAT_RATE=690
GUEST_CART_TTL_DAYS=30
# Must be true in production (enforced at startup).
COOKIE_SECURE=false
