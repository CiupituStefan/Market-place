{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["global", "components"],
  "properties": {
    "global": {
      "type": "object",
      "required": ["environment", "image", "domains", "env", "externalSecrets", "ingress"],
      "properties": {
        "environment": { "enum": ["staging", "production"] },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "registry": { "type": "string" },
            "repositoryPrefix": { "type": "string", "minLength": 1 },
            "tag": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]{0,128}$",
              "not": { "const": "latest" }
            },
            "pullPolicy": { "enum": ["IfNotPresent", "Always"] }
          }
        },
        "domains": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "web": { "type": "string" },
            "api": { "type": "string" },
            "cdn": { "type": "string" }
          }
        },
        "env": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "propertyNames": {
            "not": { "pattern": "(SECRET|PASSWORD|TOKEN|PRIVATE_KEY|DATABASE_URL)" }
          }
        },
        "database": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "caFile": { "type": "string", "pattern": "^files/.+\\.pem$" } }
        },
        "externalSecrets": { "type": "object" },
        "ingress": { "type": "object" },
        "networkPolicy": { "type": "object" },
        "preStopSleepSeconds": { "type": "integer", "minimum": 0, "maximum": 60 }
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["port", "resources"],
        "properties": {
          "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "replicas": { "type": "integer", "minimum": 1 },
          "database": { "type": "boolean" },
          "secrets": { "type": "boolean" },
          "redis": { "type": "boolean" },
          "imagePerEnvironment": { "type": "boolean" },
          "sharedEnv": { "type": "boolean" },
          "public": { "enum": ["web", "api"] },
          "allowFrom": { "type": "array", "items": { "type": "string" } },
          "iamRoleArn": { "type": "string" },
          "writablePaths": { "type": "array", "items": { "type": "string" } },
          "healthPaths": {
            "type": "object",
            "properties": { "live": { "type": "string" }, "ready": { "type": "string" } }
          },
          "resources": {
            "type": "object",
            "required": ["requests", "limits"],
            "properties": {
              "requests": { "type": "object", "required": ["cpu", "memory"] },
              "limits": { "type": "object", "required": ["memory"] }
            }
          },
          "autoscaling": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": { "type": "boolean" },
              "minReplicas": { "type": "integer", "minimum": 1 },
              "maxReplicas": { "type": "integer", "minimum": 1 },
              "targetCPUUtilization": { "type": "integer", "minimum": 10, "maximum": 100 }
            }
          },
          "env": {
            "type": "object",
            "additionalProperties": { "type": "string" },
            "propertyNames": {
              "not": { "pattern": "(SECRET|PASSWORD|TOKEN|PRIVATE_KEY|DATABASE_URL)" }
            }
          }
        }
      }
    }
  }
}
